<configs>
<!--
  Armory Unbound, Undead Legacy add-on: recipes and the research unlock.

  Why this file exists: Undead Legacy replaces the whole recipes document (set xpath="/recipes"),
  so 0-ArmoryUnbound's recipes are gone by the time UL has loaded. This folder sorts after
  UndeadLegacy and adds them back in UL's terms:
    - UL recipes use area= and time= (UL's ULM_RecipesFromXml reads both forms; UL itself has no craft_area).
    - A workstation lists every recipe whose area matches its Workstation.CraftingAreaRecipes
      (UL's H_RecipeFilter.FilterByWorkstation). The Gunsmith Bench block says "auGunsmithBench".
    - UL unlocks "learnable" recipes only through its research tree (ULM_Recipe.IsUnlocked);
      recipes without the learnable tag are always unlocked. So the bench is learnable (researched)
      and the perk parts are not (anyone with a bench can craft them).

  Costs and times are plain XML: tune them here.
-->
<append xpath="/recipes">
	<!-- The bench: Workbench tier 2 (mid-game), unlocked by the research node below. -->
	<recipe name="auGunsmithBench" count="1" time="60" area="ulmStationWorkbench_2" tags="learnable">
		<ingredient name="resourceForgedSteel" count="20"/>
		<ingredient name="resourceMechanicalParts" count="25"/>
		<ingredient name="resourceSpring" count="10"/>
		<ingredient name="resourceDuctTape" count="10"/>
		<ingredient name="resourceOil" count="5"/>
	</recipe>

	<!-- Perk parts: crafted at the Gunsmith Bench. 5 forged steel, 10 mechanical parts, 4 springs + one themed ingredient. -->
