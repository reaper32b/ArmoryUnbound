<configs>
<!--
  Armory Unbound, Undead Legacy add-on: perk parts in loot.
  Undead Legacy empties the whole loot document (set xpath="/lootcontainers") and rebuilds it,
  so 0-ArmoryUnbound's loot is gone. UL keeps the same group names for these 10 containers,
  so the same rolls are added back here, after UL. Tune the prob values here.
  auPerkParts is inserted BEFORE the first lootgroup: a group must be defined before any group
  that references it (or the whole loot.xml fails to load).
-->
<insertBefore xpath="/lootcontainers/lootgroup[1]">
	<lootgroup name="auPerkParts">
		<item name="auPartHardHitter" count="1"/>
		<item name="auPartDeepWell" count="1"/>
		<item name="auPartQuickhands" count="1"/>
		<item name="auPartIronclad" count="1"/>
		<item name="auPartExecutioner" count="1"/>
		<item name="auPartSecondWind" count="1"/>
		<item name="auPartBloodletter" count="1"/>
		<item name="auPartKindling" count="1"/>
		<item name="auPartCanOpener" count="1"/>
		<item name="auPartSledge" count="1"/>
		<item name="auPartTarPit" count="1"/>
		<item name="auPartScholar" count="1"/>
	</lootgroup>
</insertBefore>

<append xpath="/lootcontainers/lootgroup[@name='groupSmallWeaponBag']"><item group="auPerkParts" count="1" prob="0.02" force_prob="true"/></append><!-- small weapon bag -->
<append xpath="/lootcontainers/lootgroup[@name='groupGunRack']"><item group="auPerkParts" count="1" prob="0.03" force_prob="true"/></append><!-- gun rack -->
<append xpath="/lootcontainers/lootgroup[@name='groupLargeWeaponBag']"><item group="auPerkParts" count="1" prob="0.04" force_prob="true"/></append><!-- large weapon bag -->
<append xpath="/lootcontainers/lootgroup[@name='groupMilitaryFootlocker']"><item group="auPerkParts" count="1" prob="0.05" force_prob="true"/></append><!-- military footlocker, shelves, goods -->
<append xpath="/lootcontainers/lootgroup[@name='groupGunSafeSecure']"><item group="auPerkParts" count="1" prob="0.08" force_prob="true"/></append><!-- gun safe -->
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT1']"><item group="auPerkParts" count="1" prob="0.03" force_prob="true"/></append><!-- POI loot chest tier 1 (also hero chest) -->
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT2']"><item group="auPerkParts" count="1" prob="0.05" force_prob="true"/></append><!-- tier 2 -->
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT3']"><item group="auPerkParts" count="1" prob="0.08" force_prob="true"/></append><!-- tier 3 -->
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT4']"><item group="auPerkParts" count="1" prob="0.12" force_prob="true"/></append><!-- tier 4 -->
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT5']"><item group="auPerkParts" count="1" prob="0.20" force_prob="true"/></append><!-- tier 5 -->

<!--
  1.3.0: starter skins in loot (Phase 2), the same group and chances as 0-ArmoryUnbound's loot.xml (half the perk-part chance).
  The skin items AND their Gunsmith Bench recipes are generated by the DLL after every mod's patches, i.e. after UL's
  wholesale <set xpath="/recipes">, so they need nothing here. Only this loot has to be re-added after UL.
  If a starter image is deleted, the DLL drops its line from auSkins (one warning).
-->
<insertBefore xpath="/lootcontainers/lootgroup[1]">
	<lootgroup name="auSkins">
		<item name="auSkinCarbonFibre" count="1"/>
		<item name="auSkinDamascusSteel" count="1"/>
		<item name="auSkinDesertCamo" count="1"/>
		<item name="auSkinGoldFiligree" count="1"/>
		<item name="auSkinHexGrid" count="1"/>
		<item name="auSkinSnakeskin" count="1"/>
		<item name="auSkinTigerStripe" count="1"/>
		<item name="auSkinToxicHazard" count="1"/>
		<item name="auSkinUrbanDigital" count="1"/>
		<item name="auSkinWoodlandCamo" count="1"/>
		<item name="auPaintRemover" count="1"/>
	</lootgroup>
</insertBefore>

<append xpath="/lootcontainers/lootgroup[@name='groupSmallWeaponBag']"><item group="auSkins" count="1" prob="0.01" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupGunRack']"><item group="auSkins" count="1" prob="0.015" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupLargeWeaponBag']"><item group="auSkins" count="1" prob="0.02" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupMilitaryFootlocker']"><item group="auSkins" count="1" prob="0.025" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupGunSafeSecure']"><item group="auSkins" count="1" prob="0.04" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT1']"><item group="auSkins" count="1" prob="0.015" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT2']"><item group="auSkins" count="1" prob="0.025" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT3']"><item group="auSkins" count="1" prob="0.04" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT4']"><item group="auSkins" count="1" prob="0.06" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT5']"><item group="auSkins" count="1" prob="0.10" force_prob="true"/></append>

<!--
  1.5.0: corrupted perk parts (loot only, never crafted) - hardened chests T4 and T5 ONLY, at half the perk-part chance.
  Quality comes from the container's loot_quality_template, like the normal parts. Defined before use, like auPerkParts.
-->
<insertBefore xpath="/lootcontainers/lootgroup[1]">
	<lootgroup name="auCorruptParts">
		<item name="auPartGlassCannon" count="1"/>
		<item name="auPartOverclock" count="1"/>
		<item name="auPartHungryMag" count="1"/>
		<item name="auPartDeadeye" count="1"/>
		<item name="auPartBloodprice" count="1"/>
		<item name="auPartLeech" count="1"/>
		<item name="auPartWildcat" count="1"/>
		<item name="auPartHellfire" count="1"/>
		<item name="auPartOverdrive" count="1"/>
		<item name="auPartGreedy" count="1"/>
		<item name="auPartEarthshaker" count="1"/>
	</lootgroup>
</insertBefore>

<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT4']"><item group="auCorruptParts" count="1" prob="0.05" force_prob="true"/></append><!-- tier 4 -->
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT5']"><item group="auCorruptParts" count="1" prob="0.10" force_prob="true"/></append><!-- tier 5 -->

<!--
  1.1.0: tool parts. Their own group, rolled in tool containers (toolboxes, garages, workbenches, construction
  crates, crafting toolboxes) and the POI chests at the same chances as the other parts. Corrupted tool parts join
  auCorruptParts (hardened chests T4/T5 only).
-->
<insertBefore xpath="/lootcontainers/lootgroup[1]">
	<lootgroup name="auToolParts">
		<item name="auPartProspector" count="1"/>
		<item name="auPartDemolisher" count="1"/>
		<item name="auPartTireless" count="1"/>
		<item name="auPartQuickSwing" count="1"/>
		<item name="auPartFeller" count="1"/>
		<item name="auPartButcher" count="1"/>
		<item name="auPartSteadyEdge" count="1"/>
		<item name="auPartLuckyStrike" count="1"/>
	</lootgroup>
</insertBefore>
<append xpath="/lootcontainers/lootgroup[@name='groupToolbox']"><item group="auToolParts" count="1" prob="0.03" force_prob="true"/></append><!-- toolbox -->
<append xpath="/lootcontainers/lootgroup[@name='groupRollingToolbox']"><item group="auToolParts" count="1" prob="0.04" force_prob="true"/></append><!-- rolling toolbox -->
<append xpath="/lootcontainers/lootgroup[@name='groupGarage']"><item group="auToolParts" count="1" prob="0.02" force_prob="true"/></append><!-- garage -->
<append xpath="/lootcontainers/lootgroup[@name='groupWorkbenchLoot']"><item group="auToolParts" count="1" prob="0.03" force_prob="true"/></append><!-- collapsed workbench -->
<append xpath="/lootcontainers/lootgroup[@name='groupConstructionCrate']"><item group="auToolParts" count="1" prob="0.02" force_prob="true"/></append><!-- construction crate -->
<append xpath="/lootcontainers/lootgroup[@name='groupCraftingToolboxCommon']"><item group="auToolParts" count="1" prob="0.03" force_prob="true"/></append><!-- crafting toolbox -->
<append xpath="/lootcontainers/lootgroup[@name='groupCraftingToolboxUncommon']"><item group="auToolParts" count="1" prob="0.05" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupCraftingToolboxRare']"><item group="auToolParts" count="1" prob="0.08" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT1']"><item group="auToolParts" count="1" prob="0.03" force_prob="true"/></append><!-- POI chests -->
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT2']"><item group="auToolParts" count="1" prob="0.05" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT3']"><item group="auToolParts" count="1" prob="0.08" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT4']"><item group="auToolParts" count="1" prob="0.12" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT5']"><item group="auToolParts" count="1" prob="0.20" force_prob="true"/></append>
</configs>
