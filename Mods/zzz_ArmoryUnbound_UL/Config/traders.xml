<configs>
<!--
  Armory Unbound, Undead Legacy add-on 1.6.0: perk parts and starter skins at every trader (AJ, 2026-10-31).
  Normal perk parts only - corrupted parts stay loot-only. Starter skins + the Paint Removal Kit only - custom skins stay craft-only.
  Vending machines (ids 3, 4, 5, 10) and the Testing trader (9) get nothing.

  Parts: stage modsT1 (from trader stage 1) like UL's own mods, quality 1-40 like UL's common mods.
  The skin items are generated by the DLL before traders.xml loads; if a starter image is deleted the DLL drops its line here (one warning).
  count on a trader line = how many rolls that trader makes from the group per restock. Tune them here.
-->
<append xpath="/traders/trader_item_groups">
	<trader_item_group name="auTraderPerkParts">
		<item name="auPartHardHitter" stage="modsT1" quality="1,40"/>
		<item name="auPartDeepWell" stage="modsT1" quality="1,40"/>
		<item name="auPartQuickhands" stage="modsT1" quality="1,40"/>
		<item name="auPartIronclad" stage="modsT1" quality="1,40"/>
		<item name="auPartExecutioner" stage="modsT1" quality="1,40"/>
		<item name="auPartSecondWind" stage="modsT1" quality="1,40"/>
		<item name="auPartBloodletter" stage="modsT1" quality="1,40"/>
		<item name="auPartKindling" stage="modsT1" quality="1,40"/>
		<item name="auPartCanOpener" stage="modsT1" quality="1,40"/>
		<item name="auPartSledge" stage="modsT1" quality="1,40"/>
		<item name="auPartTarPit" stage="modsT1" quality="1,40"/>
		<item name="auPartScholar" stage="modsT1" quality="1,40"/>
	</trader_item_group>
	<trader_item_group name="auTraderToolParts">
		<item name="auPartProspector" stage="modsT1" quality="1,40"/>
		<item name="auPartDemolisher" stage="modsT1" quality="1,40"/>
		<item name="auPartTireless" stage="modsT1" quality="1,40"/>
		<item name="auPartQuickSwing" stage="modsT1" quality="1,40"/>
		<item name="auPartFeller" stage="modsT1" quality="1,40"/>
		<item name="auPartButcher" stage="modsT1" quality="1,40"/>
		<item name="auPartSteadyEdge" stage="modsT1" quality="1,40"/>
		<item name="auPartLuckyStrike" stage="modsT1" quality="1,40"/>
	</trader_item_group>
	<trader_item_group name="auTraderSkins">
		<item name="auSkinCarbonFibre"/>
		<item name="auSkinDamascusSteel"/>
		<item name="auSkinDesertCamo"/>
		<item name="auSkinGoldFiligree"/>
		<item name="auSkinHexGrid"/>
		<item name="auSkinSnakeskin"/>
		<item name="auSkinTigerStripe"/>
		<item name="auSkinToxicHazard"/>
		<item name="auSkinUrbanDigital"/>
		<item name="auSkinWoodlandCamo"/>
		<item name="auPaintRemover"/>
	</trader_item_group>
</append>

<!-- Gun traders: 1-3 parts, 1-2 skins per restock -->
<append xpath="/traders/trader_info[@id='1']/trader_items"><item group="auTraderToolParts" count="1"/><item group="auTraderPerkParts" count="1,3"/><item group="auTraderSkins" count="1,2"/></append><!-- Joel -->
<append xpath="/traders/trader_info[@id='8']/trader_items"><item group="auTraderToolParts" count="1"/><item group="auTraderPerkParts" count="1,3"/><item group="auTraderSkins" count="1,2"/></append><!-- Rekt -->
<append xpath="/traders/trader_info[@id='17']/trader_items"><item group="auTraderToolParts" count="1"/><item group="auTraderPerkParts" count="1,3"/><item group="auTraderSkins" count="1,2"/></append><!-- Maxton -->
