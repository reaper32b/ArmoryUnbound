<configs>
<!--
  Armory Unbound - perk parts in loot. Rare, and likelier the better the container.
  Each line below is one independent roll: prob = chance that container drops 1 random perk part. Tune them here.
  auPerkParts is inserted BEFORE the first lootgroup: the game resolves group references in document order,
  so a group must be defined before any group that references it (or the whole loot.xml fails to load).
-->
<insertBefore xpath="/lootcontainers/lootgroup[1]">
	<lootgroup name="auPerkParts">
		<item name="auPartHardHitter" count="1"/>
		<item name="auPartDeepWell" count="1"/>
		<item name="auPartQuickhands" count="1"/>
		<item name="auPartIronclad" count="1"/>
		<item name="auPartExecutioner" count="1"/>
		<item name="auPartSecondWind" count="1"/>
		<item name="auPartBloodletter" count="1"/>
		<item name="auPartKindling" count="1"/>
		<item name="auPartCanOpener" count="1"/>
		<item name="auPartSledge" count="1"/>
		<item name="auPartTarPit" count="1"/>
		<item name="auPartScholar" count="1"/>
	</lootgroup>
</insertBefore>

<append xpath="/lootcontainers/lootgroup[@name='groupSmallWeaponBag']"><item group="auPerkParts" count="1" prob="0.02" force_prob="true"/></append><!-- small weapon bag -->
<append xpath="/lootcontainers/lootgroup[@name='groupGunRack']"><item group="auPerkParts" count="1" prob="0.03" force_prob="true"/></append><!-- gun rack -->
<append xpath="/lootcontainers/lootgroup[@name='groupLargeWeaponBag']"><item group="auPerkParts" count="1" prob="0.04" force_prob="true"/></append><!-- large weapon bag -->
<append xpath="/lootcontainers/lootgroup[@name='groupMilitaryFootlocker']"><item group="auPerkParts" count="1" prob="0.05" force_prob="true"/></append><!-- military footlocker -->
<append xpath="/lootcontainers/lootgroup[@name='groupGunSafeSecure']"><item group="auPerkParts" count="1" prob="0.08" force_prob="true"/></append><!-- gun safe -->
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT1']"><item group="auPerkParts" count="1" prob="0.03" force_prob="true"/></append><!-- POI loot chest tier 1 -->
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT2']"><item group="auPerkParts" count="1" prob="0.05" force_prob="true"/></append><!-- tier 2 -->
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT3']"><item group="auPerkParts" count="1" prob="0.08" force_prob="true"/></append><!-- tier 3 -->
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT4']"><item group="auPerkParts" count="1" prob="0.12" force_prob="true"/></append><!-- tier 4 -->
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT5']"><item group="auPerkParts" count="1" prob="0.20" force_prob="true"/></append><!-- tier 5 -->

<!--
  Starter skins in loot (Phase 2, scope item 3): the 10 shipped patterns, about half the perk-part chance, same containers.
  Custom skins (your own images in Skins\Custom) are craft-only. The skin items themselves are generated by the DLL from
  the images in Skins\Starter; if a starter image is deleted the DLL drops its line from this group (one warning).
  Defined before use, like auPerkParts.
-->
<insertBefore xpath="/lootcontainers/lootgroup[1]">
	<lootgroup name="auSkins">
		<item name="auSkinCarbonFibre" count="1"/>
		<item name="auSkinDamascusSteel" count="1"/>
		<item name="auSkinDesertCamo" count="1"/>
		<item name="auSkinGoldFiligree" count="1"/>
		<item name="auSkinHexGrid" count="1"/>
		<item name="auSkinSnakeskin" count="1"/>
		<item name="auSkinTigerStripe" count="1"/>
		<item name="auSkinToxicHazard" count="1"/>
		<item name="auSkinUrbanDigital" count="1"/>
		<item name="auSkinWoodlandCamo" count="1"/>
		<item name="auPaintRemover" count="1"/>
	</lootgroup>
</insertBefore>

<append xpath="/lootcontainers/lootgroup[@name='groupSmallWeaponBag']"><item group="auSkins" count="1" prob="0.01" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupGunRack']"><item group="auSkins" count="1" prob="0.015" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupLargeWeaponBag']"><item group="auSkins" count="1" prob="0.02" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupMilitaryFootlocker']"><item group="auSkins" count="1" prob="0.025" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupGunSafeSecure']"><item group="auSkins" count="1" prob="0.04" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT1']"><item group="auSkins" count="1" prob="0.015" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT2']"><item group="auSkins" count="1" prob="0.025" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT3']"><item group="auSkins" count="1" prob="0.04" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT4']"><item group="auSkins" count="1" prob="0.06" force_prob="true"/></append>
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT5']"><item group="auSkins" count="1" prob="0.10" force_prob="true"/></append>

<!--
  Corrupted perk parts (loot only, never crafted): hardened chests T4 and T5 ONLY, at half the perk-part chance.
  Defined before use, like auPerkParts. (Undead Legacy wipes this file's loot; the UL add-on re-adds the same.)
-->
<insertBefore xpath="/lootcontainers/lootgroup[1]">
	<lootgroup name="auCorruptParts">
		<item name="auPartGlassCannon" count="1"/>
		<item name="auPartOverclock" count="1"/>
		<item name="auPartHungryMag" count="1"/>
		<item name="auPartDeadeye" count="1"/>
		<item name="auPartBloodprice" count="1"/>
		<item name="auPartLeech" count="1"/>
		<item name="auPartWildcat" count="1"/>
		<item name="auPartHellfire" count="1"/>
	</lootgroup>
</insertBefore>

<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT4']"><item group="auCorruptParts" count="1" prob="0.05" force_prob="true"/></append><!-- tier 4 -->
<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT5']"><item group="auCorruptParts" count="1" prob="0.10" force_prob="true"/></append><!-- tier 5 -->
</configs>
