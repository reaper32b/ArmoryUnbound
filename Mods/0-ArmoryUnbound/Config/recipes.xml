<configs>
<!--
  Armory Unbound - recipes. Costs are plain XML: tune them here.
  Gunsmith Bench: crafted at a workbench, learnable; unlocked by Workstations level 36 (progression.xml, RecipeTagUnlocked tag auGunsmithBench).
  Perk parts: crafted at the Gunsmith Bench (craft_area auGunsmithBench); no unlock needed once you own a bench.
  Every part costs 5 forged steel, 10 mechanical parts and 4 springs, plus one ingredient that fits its perk.
-->
<append xpath="/recipes">
	<recipe name="auGunsmithBench" count="1" craft_area="workbench" tags="learnable,workbenchCrafting,auGunsmithBench">
		<ingredient name="resourceForgedSteel" count="20"/>
		<ingredient name="resourceMechanicalParts" count="25"/>
		<ingredient name="resourceSpring" count="10"/>
		<ingredient name="resourceDuctTape" count="10"/>
		<ingredient name="resourceOil" count="5"/>
	</recipe>

	<recipe name="auPartHardHitter" count="1" craft_area="auGunsmithBench" craft_time="60" tags="auPerkPart">
		<ingredient name="resourceForgedSteel" count="5"/>
		<ingredient name="resourceMechanicalParts" count="10"/>
		<ingredient name="resourceSpring" count="4"/>
		<ingredient name="resourceGunPowder" count="50"/>
	</recipe>
